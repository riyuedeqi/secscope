# macOS / editor
.DS_Store
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Build outputs
*.o
*.a
*.dylib
*.dll
*.exe
# v2.x 起 native 组件为纯 Python：scanner/cache-daemon/cache-client 是必需的
# 启动器脚本（shebang + python3），必须随仓库分发，不再忽略。
# 若本地存在旧 C++ 构建产物，仍按以下通配排除：
native/**/build/
native/**/CMakeFiles/
native/**/CMakeCache.txt
native/**/cmake_install.cmake

# SecScope generated artifacts / local packages
dist/
prebuilt/
runtime/
archive/
work/
.scan-reports/
reports/*
!reports/.secscope-report-root

# Logs / temporary files
*.log
*.tmp
*.bak
