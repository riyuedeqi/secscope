{
  "schema_version": 1,
  "pack": {
    "name": "secscope-core",
    "version": "2026.10.30",
    "description": "SecScope unified malware signature pack. Behavioral + structural indicators only; no sample-exact hashes (anti-overfitting). Org hash IOC feeds go to file-scan.config MaliciousHashes or rules/ioc-local.txt."
  },
  "scoring": {
    "grade_malicious": 60,
    "grade_suspicious": 25,
    "grade_observe": 8,
    "path_boost_prefixes": [
      "/tmp/",
      "/var/tmp/",
      "/dev/shm/",
      "/run/",
      "/var/www/",
      "/srv/www/",
      "/home/",
      "/opt/",
      "/srv/",
      "/var/lib/nginx/",
      "/usr/share/nginx/",
      "/var/ftp/"
    ],
    "path_boost_factor": 1.25,
    "path_trusted_prefixes": [
      "/usr/lib/",
      "/usr/bin/",
      "/usr/sbin/",
      "/usr/libexec/",
      "/usr/share/doc/",
      "/usr/share/man/",
      "/lib/",
      "/lib64/",
      "/usr/local/share/doc/"
    ],
    "path_trusted_factor": 0.35,
    "package_owned_factor": 0.4,
    "user_installed_factor": 0.85,
    "max_score": 100
  },
  "content_rules": [
    {
      "id": "RS-BASH-DEVTCP",
      "family": "reverse-shell",
      "languages": [
        "shell"
      ],
      "strings_any": [
        "/dev/tcp/"
      ],
      "regex_any": [
        "bash\\s+-i[\\s>&]",
        "exec\\s+\\d+>&\\d+",
        "0<&\\d+\\s+exec\\s+\\d+>",
        "exec\\s+\\d+<>/dev/tcp/",
        "\\$line\\s+2>&\\d+",
        "cat\\s+<&\\d+"
      ],
      "min_hits": 2,
      "weight": 55,
      "description": "bash /dev/tcp 反弹 shell 组合（重定向 + 交互 shell）"
    },
    {
      "id": "RS-BASH-DEVTCP-REDIR",
